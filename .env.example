# === Jade — modele de configuration ===
# DEV : copier ce fichier en « .env » et renseigner les valeurs manquantes.
# INSTALLE : ce fichier est genere automatiquement par l'assistant
# d'installation (les identifiants sont saisis pendant le setup) — aucun secret
# n'est jamais inclus dans l'installateur ni versionne dans le depot.

# Dossier de documents a indexer (dev). En prod, les dossiers se configurent
# dans l'application (Reglages -> mot de passe admin).
DOCS_DIR=.\testdata
DATA_DIR=.\data
LOG_DIR=.\logs
MODEL_CACHE_DIR=.\models

# Modele d'embeddings local (CPU, ONNX) et decoupage
EMBED_MODEL=intfloat/multilingual-e5-large
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
TOP_K=10
MIN_SCORE=0.35

# LLM central Jade (Ollama sur AI01 via Cloudflare Tunnel + Access) — 3 niveaux
OLLAMA_URL=https://llm.example.com
OLLAMA_MODEL=qwen3.5:4b
ROUTER_MODEL=qwen3.5:2b
STRONG_MODEL=qwen3.5:9b
VISION_MODEL=qwen3.5:9b
NUM_CTX=8192
REQUEST_TIMEOUT=120

# Service token Cloudflare Access (machine -> LLM) — A RENSEIGNER
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Interface locale (loopback uniquement — le backend refuse 0.0.0.0)
UI_HOST=127.0.0.1
UI_PORT=8765
CLIENT_NAME=Jade
KEEP_ALIVE=30m
REINDEX_MINUTES=30

# Recherche web via SearXNG interne (repli DuckDuckGo) — A RENSEIGNER (facultatif)
WEB_FALLBACK=1
SEARXNG_URL=https://search.example.com
SEARXNG_CF_ACCESS_CLIENT_ID=
SEARXNG_CF_ACCESS_CLIENT_SECRET=
WEB_RESULTS=3

# Retour utilisateur (mail pre-rempli depuis l'application)
FEEDBACK_EMAIL=feedback@example.com

# OCR local (rapidocr, CPU) — necessite l'extra optionnel : pip install .[ocr]
# Sans lui, l'application fonctionne normalement (scans/images non oceerises).
OCR_ENABLED=1
OCR_INDEX=1

# Recherche hybride (vectoriel + BM25) et reranking cross-encoder
HYBRID_ENABLED=1
RERANK_ENABLED=1
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
CPU_THREADS=2

# Droits NTFS respectes par utilisateur au moment de la recherche
NTFS_FILTER=1

# Retours utilisateur : envoi par e-mail via l'API Resend (resend.com).
# Vide = repli sur le client mail local (mailto). Destinataire : FEEDBACK_EMAIL.
RESEND_API_KEY=
RESEND_FROM=Jade <jade@example.com>

# Mises a jour (releases Gitea)
# UPDATE_MODE=manual   -> poste client : bouton « Mise a jour disponible » dans l'app
# UPDATE_MODE=scheduled-> serveur RDS : bouton masque, MAJ appliquee par la tache
#   planifiee nocturne (installer/jade-update-task.ps1)
UPDATE_ENABLED=1
UPDATE_MODE=manual
GITEA_API_URL=https://git.example.com
GITEA_REPO=example/jade
# Jeton de lecture si le depot est prive (sinon laisser vide)
GITEA_TOKEN=
# Mot de passe de l'installateur chiffre (protege l'exe s'il fuite). Ecrit par
# l'assistant d'installation ; permet a l'auto-update de rester silencieux.
SETUP_PASSWORD=

# Archive .tar des modeles de recherche hebergee par Jade (Gitea) : telechargee
# au 1er lancement au lieu de HuggingFace (fiable, avec reprise ; HF bride les
# requetes non authentifiees et peut « pendre »). Vide = HuggingFace directement.
MODELS_URL=https://models.example.com/jade-models.tar
