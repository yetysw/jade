# Copier en « .env » (lu automatiquement par docker compose). NE PAS versionner .env.

# Protection facultative mais recommandée de la web-UI d'administration (port 8791).
# Vide = aucun contrôle (le port n'est de toute façon publié qu'en local).
LICSRV_ADMIN_TOKEN=

# Durée du bail JWT en jours (le client tolère bail + période de grâce hors ligne).
LICSRV_BAIL_DAYS=14
